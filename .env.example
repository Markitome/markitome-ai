DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/markitome_ai?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-random-secret"
APP_BASE_URL="https://app.markitome.ai"
API_BASE_URL="https://api.markitome.ai"

GOOGLE_CLIENT_ID="google-oauth-client-id"
GOOGLE_CLIENT_SECRET="google-oauth-client-secret"
INITIAL_ADMIN_EMAIL="admin@markitome.com"
APPROVED_EMAIL_ALLOWLIST="external@example.com"
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nplaceholder\\n-----END PRIVATE KEY-----\\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID="drive-folder-id"

OPENAI_API_KEY="openai-api-key"
OPENAI_TEXT_MODEL="gpt-5.6-luna"
ANTHROPIC_API_KEY="anthropic-api-key"
ANTHROPIC_TEXT_MODEL="claude-sonnet-5"
ANTHROPIC_VERSION="2023-06-01"
ANTHROPIC_MAX_TOKENS="4096"
TEXT_MODEL_PROVIDER="openai"
STRUCTURED_TEXT_PROVIDER="openai"

GEMINI_API_KEY="google-gemini-api-key"
NANO_BANANA_IMAGE_MODEL="gemini-3.1-flash-image"

FAL_KEY="fal-api-key"
SEEDANCE_ENDPOINT="bytedance/seedance-2.0/text-to-video"
SEEDANCE_DEFAULT_DURATION="5"
SEEDANCE_DEFAULT_RESOLUTION="720p"
SEEDANCE_DEFAULT_ASPECT_RATIO="16:9"
SEEDANCE_POLL_SECONDS="45"

CLOUDFLARE_ACCOUNT_ID="cloudflare-account-id"
CLOUDFLARE_API_TOKEN="cloudflare-api-token"
CLOUDFLARE_AI_GATEWAY_ID="optional-ai-gateway-id"
