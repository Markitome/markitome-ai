{
  "name": "markitome-ai-notetaker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply markitome-notetaker-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply markitome-notetaker-db --remote",
    "db:seed": "wrangler d1 execute markitome-notetaker-db --local --file=drizzle/seed-super-admin.sql",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@cloudflare/containers": "^0.3.7",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.8.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250709.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.24.3"
  }
}
